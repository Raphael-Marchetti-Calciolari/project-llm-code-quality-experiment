# Porta em que o servidor HTTP irá escutar
PORT=4000

# String de conexão do MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/catalogo

# Origem permitida para requisições do frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Credenciais do único administrador da loja
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio

# Tempo de expiração do token de login
JWT_EXPIRES_IN=1d
